{
  "name": "@photostructure/knex-sqlite",
  "version": "0.1.1",
  "description": "Knex.js dialect for @photostructure/sqlite",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js",
    "update:deps": "npm-check-updates --dep dev --upgrade --install always",
    "preflight": "npm install && npm run update:deps && npm test"
  },
  "keywords": [
    "knex",
    "sqlite",
    "sqlite3",
    "photostructure",
    "database",
    "query-builder",
    "dialect",
    "node-sqlite"
  ],
  "author": "PhotoStructure Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photostructure/knex-sqlite.git"
  },
  "homepage": "https://github.com/photostructure/knex-sqlite#readme",
  "bugs": {
    "url": "https://github.com/photostructure/knex-sqlite/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@photostructure/sqlite": ">=2.0.0",
    "knex": ">=3.0.0"
  },
  "devDependencies": {
    "@photostructure/sqlite": "2.2.0",
    "knex": "3.3.0",
    "npm-check-updates": "22.2.9"
  }
}
